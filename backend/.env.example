# Exact frontend origin allowed by CORS (no trailing slash).
FRONTEND_ORIGIN=http://localhost:5173
PORT=3000

# Backend-only PostgreSQL settings. Replace the placeholder only in your local .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=unblock
DB_USER=unblock_app
DB_PASSWORD=replace_with_your_local_password

# Run npm run build then npm run host:password locally. Copy its output only to .env.
# Empty means host login is disabled until a valid hash is configured.
HOST_PASSWORD_HASH=

# Optional Gemini Developer API (Google AI Studio), backend only; never use VITE_.
# Enter the real key only in your ignored backend/.env. Empty uses a fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
