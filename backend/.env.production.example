# Copy manually or use scripts/prepare-production-env.mjs. No real values here.
NODE_ENV=production
SERVE_FRONTEND=true
FRONTEND_ORIGIN=https://your-service.onrender.com
DB_HOST=your-direct-neon-host.neon.tech
DB_PORT=5432
